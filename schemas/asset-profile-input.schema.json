{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["assets"],
  "properties": {
    "assets": {
      "type": "array", "maxItems": 100,
      "items": {"type": "object", "additionalProperties": false, "required": ["asset_id"],
        "properties": {
          "asset_id": {"type": "string"}, "parent_asset_id": {"type": "string"},
          "kind": {"type": "string"}, "locator_ref": {"type": "string", "pattern": "^(?:opaque:[0-9a-f]{32}|hmac-sha256:[0-9a-f]{64})$"},
          "content_type": {"type": "string"}, "local_file": {"type": "string"}
        }}
    }
  }
}
