{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Open-Detective ownership scope",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "expires_at", "targets"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "expires_at": {"type": "string", "format": "date-time"},
    "targets": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["origin", "owner", "ownership_evidence", "path_prefixes"],
      "properties": {
        "origin": {"type": "string", "format": "uri", "pattern": "^https://"},
        "owner": {"type": "string", "minLength": 1, "maxLength": 256},
        "ownership_evidence": {"type": "string", "minLength": 1, "maxLength": 256},
        "path_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^/"}}
      }
    }},
    "exclude_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "max_bytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
    "max_requests": {"type": "integer", "minimum": 1, "maximum": 10000},
    "timeout": {"type": "integer", "minimum": 1, "maximum": 120},
    "max_redirects": {"type": "integer", "minimum": 0, "maximum": 20},
    "allow_credentials_in_url": {"const": false}
  }
}
