{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/su-detect/discovery-channel.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["version","scope_id","provider","channel_id","source_id","expected_control_ids","query","endpoint","limits"],
  "properties": {
    "version": {"const": 1}, "scope_id": {"$ref":"#/$defs/id"}, "source_id": {"$ref":"#/$defs/id"},
    "provider": {"enum":["certspotter","generic_json_export"]},
    "expected_control_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "channel_id": {"enum":["certificate_transparency","web","documents"]},
    "query": {"type":"object","additionalProperties":false,"required":["work_id","value"],"properties":{"work_id":{"$ref":"#/$defs/id"},"value":{"type":"string","minLength":1,"maxLength":512}}},
    "endpoint": {"type":"object","minProperties":1},
    "limits": {"type":"object","additionalProperties":false,"properties":{"max_requests":{"type":"integer","minimum":1,"maximum":30},"max_pages":{"type":"integer","minimum":1,"maximum":30},"max_body_bytes":{"type":"integer","minimum":1,"maximum":4194304},"max_candidates":{"type":"integer","minimum":1,"maximum":10000}}}
  },
  "allOf":[
    {"if":{"properties":{"provider":{"const":"certspotter"}}},"then":{"properties":{"channel_id":{"const":"certificate_transparency"},"endpoint":{"type":"object","additionalProperties":false,"required":["url","include_subdomains"],"properties":{"url":{"const":"https://api.certspotter.com/v1/issuances"},"include_subdomains":{"type":"boolean"}}}}}},
    {"if":{"properties":{"provider":{"const":"generic_json_export"}}},"then":{"properties":{"endpoint":{"type":"object","additionalProperties":false,"required":["url","query_param","results_pointer","url_pointer"],"properties":{"url":{"type":"string","format":"uri","pattern":"^https://"},"query_param":{"type":"string","minLength":1,"maxLength":128},"page_param":{"type":"string","minLength":1,"maxLength":128},"start_page":{"type":"integer","minimum":0,"maximum":1000000},"results_pointer":{"type":"string","maxLength":256},"url_pointer":{"type":"string","maxLength":256},"record_id_pointer":{"type":"string","maxLength":256},"has_more_pointer":{"type":"string","maxLength":256}}}}}}
  ],
  "$defs": {"id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}
}
